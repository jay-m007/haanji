# Copy this file to .env and fill in what you use. Never share .env or paste it into a chat.

# --- The model (Ollama) ---
HAANJI_MODEL=gemma3:4b
# OLLAMA_HOST=http://127.0.0.1:11434

# --- Dashboard password: REQUIRED before you start a tunnel ---
HAANJI_PASSWORD=

# --- Speech: local (free, needs `npm run speech`), sarvam (paid, faster on weak GPUs), or off ---
HAANJI_SPEECH=local
# HAANJI_SPEECH_URL=http://127.0.0.1:5070
# SARVAM_API_KEY=
# SARVAM_SPEAKER=priya

# --- Language when the call does not say: hi, mr, gu, en ---
HAANJI_LANG=hi

# --- Exotel phone line: a long random secret, also put in the Voicebot URL as ?key=... ---
HAANJI_EXOTEL_TOKEN=

# --- Telegram alerts to the owner (see `npm run telegram`) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Your public tunnel address, used for links in Telegram messages ---
# HAANJI_PUBLIC_URL=https://haanji.example.com

# --- Online calls page (/call): on or off, and how many at once ---
# HAANJI_WEB_CALLS=on
# HAANJI_WEB_MAX=2
